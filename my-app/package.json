{
  "name": "my-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "set \"NODE_ENV=development\" && node --watch --import remix/node-tsx server.ts",
    "hmr": "set \"NODE_ENV=development\" && node hmr.ts",
    "start": "set \"NODE_ENV=production\" && node --import remix/node-tsx server.ts",
    "test": "set \"NODE_ENV=test\" && remix test",
    "typecheck": "tsc --noEmit",
    "swagger:generate": "multi-file-swagger -o yaml swagger/index.yaml > swagger/openapi.yaml",
    "swagger:generate2": "redocly build-docs swagger/bundle.yaml --output=swagger/index.html",
    "swagger:bundle": "redocly bundle swagger/index.yaml --output swagger/bundle.yaml",
    "swagger:sw2dts": "sw2dts swagger/bundle.json > swagger/types.d.ts",
    "swagger:typescript": "openapi-ts"
  },
  "engines": {
    "node": ">=24.3.0"
  },
  "dependencies": {
    "remix": "^3.1.0"
  },
  "devDependencies": {
    "@hey-api/openapi-ts": "0.99.0",
    "@redocly/cli": "^2.73.0",
    "@types/node": "latest",
    "multi-file-swagger": "^2.3.0",
    "sw2dts": "^2.6.3",
    "typescript": "^7.0.2"
  }
}
